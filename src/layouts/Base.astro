---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  /** The page's own title; the site title is appended in the browser tab. */
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const tabTitle = title ? `${title} · ${SITE.title}` : SITE.title;
// GoatCounter: cookieless visitor counts, only in production builds, never during `npm run dev`.
const analytics = Boolean(SITE.goatcounter) && import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    {
      analytics && (
        <script is:inline data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">{SITE.title}</a>
      <nav>
        <a href="/">Posts</a>
        <a href="/tags/">Tags</a>
        <a href="/about/">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      © {new Date().getFullYear()} {SITE.author}
    </footer>
    {
      analytics && (
        <noscript>
          <img src={`https://${SITE.goatcounter}.goatcounter.com/count?p=${encodeURIComponent(Astro.url.pathname)}&t=${encodeURIComponent(title ?? SITE.title)}`} width="1" height="1" alt="" />
        </noscript>
      )
    }
  </body>
</html>
